# Copy to .env.local for local development.
# Values come from your Supabase project: Dashboard → Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# In the Vercel dashboard, add the same two variables
# (VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY) to your project's
# Environment Variables so the production build picks them up.
